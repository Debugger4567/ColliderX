digraph ColliderXFeynman {
  rankdir=LR;
  graph [bgcolor="#0f1220", fontname="Helvetica", fontsize=12];
  node [fontname="Helvetica", fontsize=11, color="#c0caf5", fontcolor="#e5e9f0"];
  edge [fontname="Helvetica", fontsize=10, color="#c0caf5", fontcolor="#c0caf5", arrowsize=0.8];
  n1 [label="Z boson", shape=ellipse, style="filled", fillcolor="#1f2335", peripheries=1];
  n2 [label="μ+ μ−", shape=box, style="filled", fillcolor="#2a2f45", peripheries=1];
  n3 [label="Antimuon", shape=ellipse, style="filled", fillcolor="#1f2335", peripheries=1];
  n4 [label="e+ nu_e nu_mubar", shape=box, style="filled", fillcolor="#2a2f45", peripheries=1];
  n5 [label="Positron", shape=ellipse, style="filled", fillcolor="#1f2335", peripheries=1];
  n6 [label="Electron neutrino", shape=ellipse, style="filled", fillcolor="#1f2335", peripheries=1];
  n7 [label="Muon antineutrino", shape=ellipse, style="filled", fillcolor="#1f2335", peripheries=1];
  n8 [label="Muon", shape=ellipse, style="filled", fillcolor="#1f2335", peripheries=1];
  n9 [label="e- nu_ebar nu_mu", shape=box, style="filled", fillcolor="#2a2f45", peripheries=1];
  n10 [label="Electron", shape=ellipse, style="filled", fillcolor="#1f2335", peripheries=1];
  n11 [label="Electron antineutrino", shape=ellipse, style="filled", fillcolor="#1f2335", peripheries=1];
  n12 [label="Muon neutrino", shape=ellipse, style="filled", fillcolor="#1f2335", peripheries=1];
  n1 -> n2 [style=dotted, color="#7dcfff"];
  n2 -> n3 [style=solid, color="#9ece6a"];
  n3 -> n4 [style=dotted, color="#7dcfff"];
  n4 -> n5 [style=solid, color="#d6deeb"];
  n4 -> n6 [style=solid, color="#9ece6a"];
  n4 -> n7 [style=solid, color="#9ece6a"];
  n2 -> n8 [style=solid, color="#9ece6a"];
  n8 -> n9 [style=dotted, color="#7dcfff"];
  n9 -> n10 [style=solid, color="#9ece6a"];
  n9 -> n11 [style=solid, color="#9ece6a"];
  n9 -> n12 [style=solid, color="#9ece6a"];
}