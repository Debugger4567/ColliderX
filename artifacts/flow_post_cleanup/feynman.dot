digraph ColliderXFeynman {
  rankdir=LR;
  graph [bgcolor="#0f1220", fontname="Helvetica", fontsize=12];
  node [fontname="Helvetica", fontsize=11, color="#c0caf5", fontcolor="#e5e9f0"];
  edge [fontname="Helvetica", fontsize=10, color="#c0caf5", fontcolor="#c0caf5", arrowsize=0.8];
  n1 [label="Muon", shape=ellipse, style="filled", fillcolor="#1f2335", peripheries=1];
  n2 [label="e- nu_ebar nu_mu", shape=box, style="filled", fillcolor="#2a2f45", peripheries=1];
  n3 [label="Electron", shape=ellipse, style="filled", fillcolor="#1f2335", peripheries=1];
  n4 [label="Electron antineutrino", shape=ellipse, style="filled", fillcolor="#1f2335", peripheries=1];
  n5 [label="Muon neutrino", shape=ellipse, style="filled", fillcolor="#1f2335", peripheries=1];
  n1 -> n2 [style=dotted, color="#7dcfff"];
  n2 -> n3 [style=solid, color="#9ece6a"];
  n2 -> n4 [style=solid, color="#9ece6a"];
  n2 -> n5 [style=solid, color="#9ece6a"];
}